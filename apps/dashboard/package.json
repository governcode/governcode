{
  "name": "@governcode/dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "GovernCode Dashboard: the desktop app, a thin client of govd",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run typecheck && node scripts/build.ts",
    "prestart": "node ../../node_modules/electron/install.js",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@governcode/protocol": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "vite": "^8.3.1"
  }
}
